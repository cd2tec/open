---
import type { CatalogEntry } from '../content.config';
import Card from './Card.astro';
import {
  AGENTS,
  AUDIENCES,
  SHELVES,
  SHELF_ORDER,
  filterHeading,
  filterPath,
  matches,
  plural,
  type Audience,
  type ShelfKey,
} from '../lib/catalog';

interface Props {
  entries: CatalogEntry[];
  publico?: Audience;
  tipo?: ShelfKey;
}

const { entries, publico, tipo } = Astro.props;
const isHome = !publico && !tipo;
const visible = entries.filter((e) => matches(e, publico, tipo));
const HeadingTag = isHome ? 'h2' : 'h1';
const ShelfTag = isHome ? 'h3' : 'h2';
const cardTag = isHome ? 'h4' : 'h3';

const presentTypes = SHELF_ORDER.filter((t) => entries.some((e) => matches(e, undefined, t)));
const shelves = SHELF_ORDER.map((t) => {
  const items = visible.filter((e) => matches(e, undefined, t));
  const combos = items.filter((e) => e.includes);
  // O que está num combo aparece na ordem definida pelo plugin.
  const order = combos.flatMap((e) => e.includes ?? []);
  const rank = (e: CatalogEntry) => (order.includes(e.slug) ? order.indexOf(e.slug) : order.length);
  return { type: t, combos, items: items.filter((e) => !e.includes).sort((a, b) => rank(a) - rank(b)) };
}).filter((s) => s.combos.length + s.items.length > 0);

const audienceChips = [
  { label: 'Todos', value: undefined },
  ...(Object.keys(AUDIENCES) as Audience[]).map((a) => ({ label: AUDIENCES[a].label, value: a })),
].map((c) => ({
  ...c,
  count: entries.filter((e) => matches(e, c.value, tipo)).length,
  href: filterPath(c.value, tipo),
  current: c.value === publico,
}));

const typeChips = [
  { label: 'Tudo', value: undefined },
  ...presentTypes.map((t) => ({ label: SHELVES[t].plural, value: t })),
].map((c) => ({
  ...c,
  count: entries.filter((e) => matches(e, publico, c.value)).length,
  href: filterPath(publico, c.value),
  current: c.value === tipo,
}));

const agents = Object.keys(AGENTS).filter((a) => visible.some((e) => e.works_with?.includes(a as never)));
---

<section id="catalogo" class="wrap scroll-mt-4 pt-14" data-catalog>
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <HeadingTag class="text-4xl font-extrabold tracking-tight md:text-5xl">
      {filterHeading(publico, tipo)}
    </HeadingTag>
    <p class="font-semibold text-ink-soft" data-count aria-live="polite">{plural(visible.length)}</p>
  </div>

  <div class="mt-6 space-y-3">
    <div role="group" aria-label="Filtrar por público" class="flex flex-wrap gap-2">
      {
        audienceChips.map((c) =>
          c.count > 0 ? (
            <a class="chip" href={c.href} aria-current={c.current ? 'page' : undefined} data-filter-link>
              {c.label} <span class="chip-count">{c.count}</span>
            </a>
          ) : (
            <span class="chip" aria-disabled="true">
              {c.label} <span class="chip-count">0</span>
            </span>
          ),
        )
      }
    </div>
    <div role="group" aria-label="Filtrar por tipo" class="flex flex-wrap gap-2">
      {
        typeChips.map((c) =>
          c.count > 0 ? (
            <a class="chip" href={c.href} aria-current={c.current ? 'page' : undefined} data-filter-link>
              {c.label} <span class="chip-count">{c.count}</span>
            </a>
          ) : (
            <span class="chip" aria-disabled="true">
              {c.label} <span class="chip-count">0</span>
            </span>
          ),
        )
      }
    </div>
    {
      agents.length > 0 && (
        <div role="group" aria-label="Filtrar por agente de IA" class="flex flex-wrap gap-2" data-agent-filter hidden>
          <button type="button" class="chip" data-agent="" aria-pressed="true">
            Qualquer agente
          </button>
          {agents.map((a) => (
            <button type="button" class="chip" data-agent={a} aria-pressed="false">
              {AGENTS[a]}
            </button>
          ))}
        </div>
      )
    }
  </div>

  <div class="mt-12 space-y-14">
    {
      shelves.map((shelf) => (
        <section class="shelf grid gap-6 lg:grid-cols-[15rem_1fr] lg:gap-10" data-shelf>
          <div class="lg:sticky lg:top-6 lg:self-start">
            <ShelfTag class="text-2xl font-extrabold tracking-tight">{SHELVES[shelf.type].plural}</ShelfTag>
            <p class="mt-1 text-ink-soft">{SHELVES[shelf.type].blurb}</p>
          </div>
          <div class="min-w-0">
            {shelf.combos.length > 0 && (
              <ul class="grid gap-4">
                {shelf.combos.map((entry) => (
                  <li data-card-item>
                    <Card entry={entry} headingTag={cardTag} wide />
                  </li>
                ))}
              </ul>
            )}
            {shelf.items.length > 0 && (
              <div class:list={{ 'combo-items': shelf.combos.length > 0 }}>
                {shelf.combos.length > 0 && <p class="mb-3 font-bold">O que vem no combo</p>}
                <ul class="grid gap-4 md:grid-cols-2">
                  {shelf.items.map((entry) => (
                    <li data-card-item>
                      <Card entry={entry} headingTag={cardTag} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      ))
    }
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-catalog]');
  const group = root?.querySelector<HTMLElement>('[data-agent-filter]');

  if (root && group) {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-agent]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-card-item]')];
    const shelves = [...root.querySelectorAll<HTMLElement>('[data-shelf]')];
    const count = root.querySelector<HTMLElement>('[data-count]');
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-filter-link]')];
    const known = new Set(buttons.map((b) => b.dataset.agent));

    const apply = (agent: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.agent === agent)));

      let shown = 0;
      items.forEach((item) => {
        const agents = item.querySelector<HTMLElement>('[data-card]')?.dataset.agents?.split(' ') ?? [];
        const match = !agent || agents.includes(agent);
        item.hidden = !match;
        if (match) shown += 1;
      });
      shelves.forEach((shelf) => {
        shelf.hidden = !shelf.querySelector('[data-card-item]:not([hidden])');
      });
      if (count) count.textContent = `${shown} ${shown === 1 ? 'recurso' : 'recursos'}`;

      const url = new URL(location.href);
      if (agent) url.searchParams.set('agente', agent);
      else url.searchParams.delete('agente');
      history.replaceState(null, '', url);

      links.forEach((link) => {
        const target = new URL(link.href);
        if (agent) target.searchParams.set('agente', agent);
        else target.searchParams.delete('agente');
        link.href = target.pathname + target.search;
      });
    };

    group.hidden = false;
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.agent ?? '')));

    const initial = new URLSearchParams(location.search).get('agente');
    if (initial && known.has(initial)) apply(initial);
  }
</script>
