---
// Gôndola do hero, desenhada na mesma grade do robô (1 unidade = 4 px). O desenho sai pronto do build;
// o JavaScript abaixo só cuida de arrastar os produtos.
const WIDTH = 96;
const HEIGHT = 72;
const UNIT = 4;

const COLORS: Record<string, string> = {
  w: '#f2f2f2',
  y: '#dbff2a',
  g: '#a1a6ae',
  s: '#8f8fff',
  b: '#0000ff',
  k: '#000000',
};

type Sprite = string[];

const CARTON: Sprite = ['..ww..', '.wwww.', 'wwwwww', 'wwwwww', 'wbbbbw', 'wbyybw', 'wbbbbw', 'wwwwww', 'wwwwww'];
const BOTTLE: Sprite = ['.gg.', '.gg.', '.ss.', 'ssss', 'ssss', 'swws', 'swws', 'ssss', 'ssss', 'ssss'];
const CAN: Sprite = ['ggggg', 'wwwww', 'wyyyw', 'wyyyw', 'wwwww', 'ggggg'];
const BOX: Sprite = ['yyyyyyy', 'ybbbbby', 'ybwwwby', 'ybbbbby', 'yyyyyyy', 'yyyyyyy', 'ywwwwwy', 'yyyyyyy', 'yyyyyyy', 'yyyyyyy'];
const JAR: Sprite = ['ggggg', '.www.', 'wsssw', 'wssww', 'wwwww', 'wyyyw', 'wwwww'];
const BAG: Sprite = ['s.s.s.s', 'sssssss', 'swwwwws', 'swbbbws', 'swbbbws', 'swwwwws', 'sssssss', 'sssssss'];
const CART: Sprite = [
  'gg................',
  '.g....yyyy........',
  '.g....ybby..ss....',
  '.g....yyyy..ss....',
  '.gwwwwwwwwwwwwwww.',
  '.gw.w.w.w.w.w.w.w.',
  '.gwwwwwwwwwwwwwww.',
  '..gw.w.w.w.w.w.w..',
  '..gwwwwwwwwwwwww..',
  '...g...........g..',
  '..gggggggggggggg..',
  '...kk.......kk....',
  '...kk.......kk....',
];

const recolor = (sprite: Sprite, swap: Record<string, string>): Sprite =>
  sprite.map((row) => [...row].map((c) => swap[c] ?? c).join(''));

const grid = Array.from({ length: HEIGHT }, () => Array<string>(WIDTH).fill('.'));

function stamp(sprite: Sprite, x: number, y: number) {
  sprite.forEach((row, j) =>
    [...row].forEach((c, i) => {
      if (c !== '.' && grid[y + j]?.[x + i] !== undefined) grid[y + j][x + i] = c;
    }),
  );
}

interface Product {
  sprite: Sprite;
  run: number;
  x: number;
  top: number;
}

const products: Product[] = [];
const runs: [from: number, to: number, top: number][] = [];

// Cada produto aparece em frentes repetidas, como na loja. As etiquetas ficam presas no trilho da prateleira.
function stock(top: number, from: number, to: number, blocks: [Sprite, number][]) {
  const run = runs.push([from, to, top]) - 1;
  let x = from;
  for (const [sprite, count] of blocks) {
    const width = sprite[0].length;
    const total = count * (width + 1) - 1;
    if (x + total > to) break;
    for (let i = 0; i < count; i++) products.push({ sprite, run, x: x + i * (width + 1), top });
    stamp(['yyy', 'yyy'], x + Math.floor((total - 3) / 2), top);
    x += total + 3;
  }
}

const SHELVES = [22, 38, 54, 70];

stock(SHELVES[0], 4, 93, [
  [CARTON, 3],
  [BOTTLE, 4],
  [BOX, 2],
  [recolor(CARTON, { b: 'g' }), 2],
]);
stock(SHELVES[1], 4, 93, [
  [CAN, 5],
  [JAR, 4],
  [recolor(CAN, { y: 's' }), 4],
]);
stock(SHELVES[2], 4, 93, [
  [BAG, 3],
  [recolor(BOTTLE, { s: 'y' }), 4],
  [BOX, 2],
  [JAR, 2],
]);
// O vão na prateleira de baixo é onde o robô está repondo, e o carrinho cobre o final.
stock(SHELVES[3], 4, 26, [[recolor(BOX, { y: 'w', w: 'y' }), 2]]);
stock(SHELVES[3], 40, 70, [
  [recolor(CAN, { y: 's' }), 2],
  [JAR, 2],
]);
stamp(CART, 72, HEIGHT - CART.length);

// Toldo listrado no topo, com a barra recortada.
for (let x = 0; x < WIDTH; x++) {
  const stripe = Math.floor(x / 6);
  const light = stripe % 2 === 0;
  const depth = x % 6 === 0 || x % 6 === 5 ? 6 : 8;
  for (let y = 0; y < depth; y++) grid[y][x] = light ? 'w' : 's';
}

function toPaths(rows: ArrayLike<string>[]): string {
  return Object.keys(COLORS)
    .map((color) => {
      let d = '';
      for (let y = 0; y < rows.length; y++) {
        const row = rows[y];
        for (let x = 0; x < row.length; x++) {
          if (row[x] !== color) continue;
          let n = 1;
          while (row[x + n] === color) n++;
          d += `M${x} ${y}h${n}v1h-${n}z`;
          x += n - 1;
        }
      }
      return d ? `<path fill="${COLORS[color]}" d="${d}"/>` : '';
    })
    .join('');
}

const kinds = [...new Set(products.map((p) => p.sprite))];

// Para a atenção (ver o script abaixo), cada tipo de produto vira um vetor tirado dos próprios pixels:
// a fração de cada cor, mais a largura e a altura. Sai centrado na média e com tamanho 1, para que
// produtos parecidos apontem para o mesmo lado e os diferentes, para lados opostos.
const features = kinds.map((sprite) => {
  const cells = [...sprite.join('')].filter((c) => c !== '.');
  const shares = Object.keys(COLORS).map((color) => cells.filter((c) => c === color).length / cells.length);
  return [...shares, sprite[0].length / 10, sprite.length / 10];
});
const mean = features[0].map((_, i) => features.reduce((sum, feature) => sum + feature[i], 0) / features.length);
const contents = features.map((feature) => {
  const diff = feature.map((value, i) => value - mean[i]);
  const norm = Math.hypot(...diff) || 1;
  return diff.map((value) => Number((value / norm).toFixed(4)));
});

const defs = `<defs>${kinds.map((sprite, i) => `<g id="scene-p${i}">${toPaths(sprite)}</g>`).join('')}</defs>`;

const items = products
  .map(({ sprite, run, x, top }) => {
    const kind = kinds.indexOf(sprite);
    const w = sprite[0].length;
    const h = sprite.length;
    return (
      `<g class="scene-item" transform="translate(${x} ${top - h})" data-run="${run}" data-kind="${kind}" data-x="${x}" data-w="${w}" data-h="${h}">` +
      `<rect width="${w}" height="${h}" fill="transparent"/><use href="#scene-p${kind}"/></g>`
    );
  })
  .join('');

const panel = `<rect x="0" y="4" width="${WIDTH}" height="${HEIGHT - 4}" fill="#0000c4"/>`;
const uprights = [0, WIDTH - 2].map((x) => `<rect x="${x}" y="4" width="2" height="${HEIGHT - 4}" fill="#5c5cff"/>`).join('');
const shelves = SHELVES.map((y) => `<rect class="scene-shelf" x="2" y="${y}" width="${WIDTH - 4}" height="2" fill="#5c5cff"/>`).join('');
---

<svg
  class="hidden lg:block"
  viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
  width={WIDTH * UNIT}
  height={HEIGHT * UNIT}
  shape-rendering="crispEdges"
  aria-hidden="true"
  data-scene={JSON.stringify(runs)}
  data-contents={JSON.stringify(contents)}
  set:html={defs + panel + uprights + shelves + toPaths(grid) + items}
/>

<script>
  import { attend, positionalEncoding } from '../lib/attention';

  interface Run {
    from: number;
    to: number;
    top: number;
    items: Item[];
  }

  interface Item {
    el: SVGGElement;
    kind: string;
    w: number;
    h: number;
    x: number;
    run: Run;
  }

  const svg = document.querySelector<SVGSVGElement>('[data-scene]');

  if (svg && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const runs: Run[] = (JSON.parse(svg.dataset.scene!) as number[][]).map(([from, to, top]) => ({ from, to, top, items: [] }));

    const items = [...svg.querySelectorAll<SVGGElement>('.scene-item')].map((el) => {
      const { run, kind, w, h, x } = el.dataset;
      const item: Item = { el, kind: kind!, w: Number(w), h: Number(h), x: Number(x), run: runs[Number(run)] };
      item.run.items.push(item);
      return item;
    });

    const moveTo = (item: Item, x: number, y: number) => {
      item.el.style.transform = `translate(${x}px, ${y}px)`;
    };
    const settle = (item: Item) => moveTo(item, item.x, item.run.top - item.h);

    // Tenta o respiro normal entre produtos diferentes e aperta só se a prateleira não comportar.
    const gapThatFits = (run: Run) => {
      const width = run.items.reduce((sum, item) => sum + item.w, 0);
      const changes = run.items.slice(1).filter((item, i) => item.kind !== run.items[i].kind).length;
      const repeats = run.items.length - 1 - changes;
      return [3, 2, 1].find((gap) => run.from + width + repeats + changes * gap <= run.to) ?? 0;
    };

    const arrange = (run: Run) => {
      const gap = gapThatFits(run);
      let x = run.from;
      run.items.forEach((item, i) => {
        if (i > 0) x += item.kind === run.items[i - 1].kind ? 1 : gap;
        item.x = x;
        settle(item);
        x += item.w;
      });
    };

    const exchange = (a: Item, b: Item) => {
      const [runA, runB] = [a.run, b.run];
      const [indexA, indexB] = [runA.items.indexOf(a), runB.items.indexOf(b)];
      runA.items[indexA] = b;
      runB.items[indexB] = a;
      [a.run, b.run] = [runB, runA];
    };

    const swap = (a: Item, b: Item) => {
      exchange(a, b);
      if (gapThatFits(a.run) && gapThatFits(b.run)) {
        arrange(a.run);
        arrange(b.run);
      } else {
        exchange(a, b);
        settle(a);
      }
    };

    const toScene = (event: PointerEvent) => {
      const box = svg.getBoundingClientRect();
      const scale = svg.viewBox.baseVal.width / box.width;
      return { x: (event.clientX - box.left) * scale, y: (event.clientY - box.top) * scale };
    };

    const itemAt = (dragged: Item, x: number, y: number) =>
      items
        .filter((item) => {
          if (item === dragged) return false;
          return x >= item.x - 1 && x <= item.x + item.w + 1 && y >= item.run.top - 14 && y <= item.run.top + 2;
        })
        .sort((a, b) => Math.abs(a.x + a.w / 2 - x) - Math.abs(b.x + b.w / 2 - x))[0];

    // Homenagem a "Attention Is All You Need": clicar num produto mostra para quais outros ele "olha".
    // A conta é a do paper, softmax(q·k / √d_k), e roda de verdade a cada clique (src/lib/attention.ts).
    // Os vetores não são treinados: o conteúdo vem dos pixels do produto e a posição, do lugar dele na
    // gôndola, codificado em senos e cossenos. Por isso o desenho muda quando os produtos trocam de lugar.

    // Quanto o conteúdo pesa diante da posição. Com 4, um produto igual do outro lado da gôndola
    // ainda atrai mais que um produto diferente logo ao lado.
    const CONTENT_WEIGHT = 4;
    const contents = (JSON.parse(svg.dataset.contents!) as number[][]).map((content) => content.map((value) => value * CONTENT_WEIGHT));
    const shelfTops = [...new Set(runs.map((run) => run.top))].sort((a, b) => a - b);

    const embed = (item: Item) => [
      ...contents[Number(item.kind)],
      ...positionalEncoding(item.x + item.w / 2, 8),
      ...positionalEncoding(shelfTops.indexOf(item.run.top), 4),
    ];

    // A conta daquele clique, para o balão: as três maiores notas e no que o softmax as transforma.
    // A primeira é sempre o próprio produto, porque ele também entra na conta, como no paper.
    const proof = (scores: number[], weights: number[]) => {
      const top = weights
        .map((_, i) => i)
        .sort((a, b) => weights[b] - weights[a])
        .slice(0, 3);
      const list = (values: string[]) => `[${values.join(' ')} …]`;
      return (
        `Conta de verdade, entre ${items.length} produtos:<br>` +
        `<code>softmax(q·k/√dₖ)</code><br>` +
        `<code>${list(top.map((i) => scores[i].toFixed(1)))} → ${list(top.map((i) => weights[i].toFixed(2).slice(1)))}</code><br>` +
        `<cite>Attention Is All You Need · 1706.03762</cite>`
      );
    };

    const SVG_NS = 'http://www.w3.org/2000/svg';
    const layer = document.createElementNS(SVG_NS, 'g');
    layer.setAttribute('class', 'scene-attention');
    const crown = (item: Item) => ({ x: item.x + item.w / 2, y: item.run.top - item.h - 0.5 });
    let attended: Item | undefined;

    const clearAttention = () => {
      attended = undefined;
      layer.replaceChildren();
      items.forEach((item) => (item.el.style.opacity = ''));
    };

    // Acende cada produto na medida do peso que recebeu e devolve a conta, para o robô mostrar.
    const showAttention = (from: Item) => {
      const { scores, weights } = attend(embed(from), items.map(embed));
      const strongest = Math.max(...weights.filter((_, i) => items[i] !== from));
      const start = crown(from);
      const arcs: SVGPathElement[] = [];
      items.forEach((item, i) => {
        if (item === from) return;
        const relative = weights[i] / strongest;
        item.el.style.opacity = String(0.4 + 0.6 * relative);
        if (relative < 0.04) return;
        // Arco por cima dos produtos, para a linha não riscar a embalagem dos vizinhos.
        const end = crown(item);
        const lift = Math.min(7, 2 + Math.hypot(end.x - start.x, end.y - start.y) * 0.18);
        const arc = document.createElementNS(SVG_NS, 'path');
        arc.setAttribute('d', `M${start.x} ${start.y}Q${(start.x + end.x) / 2} ${Math.min(start.y, end.y) - lift} ${end.x} ${end.y}`);
        arc.setAttribute('stroke-opacity', relative.toFixed(3));
        arcs.push(arc);
      });
      layer.replaceChildren(...arcs);
      // Vai para o fim do desenho para os arcos passarem por cima dos produtos.
      svg.append(layer);
      attended = from;
      return proof(scores, weights);
    };

    // Quem explica a brincadeira é o robô. Com o mouse na gôndola ele ensina a arrastar e a clicar;
    // a cada clique mostra a conta daquele produto e, depois do primeiro, para de repetir a dica.
    // Durante o jogo o botão dele fica invisível, e o balão some junto.
    const HINT = 'Arraste para mover os produtos. Clique em um e veja a atenção funcionando, o algoritmo que revolucionou a IA.';
    const robot = document.querySelector<HTMLElement>('[data-game-trigger]');
    let bubble: HTMLElement | undefined;
    let learned = false;

    const hush = () => {
      bubble?.remove();
      bubble = undefined;
      robot?.classList.remove('explaining');
    };

    const say = (html: string) => {
      hush();
      if (!robot?.offsetParent) return;
      bubble = document.createElement('span');
      bubble.className = 'game-bubble scene-says';
      bubble.setAttribute('aria-hidden', 'true');
      bubble.innerHTML = html;
      bubble.addEventListener('animationend', hush);
      robot.append(bubble);
      // Enquanto ele explica, o "Psiu!" do jogo sai da frente.
      robot.classList.add('explaining');
    };

    svg.addEventListener('pointerenter', () => {
      if (!learned) say(HINT);
    });
    svg.addEventListener('pointerleave', hush);
    robot?.addEventListener('click', hush);
    // Clicar no fundo da gôndola desliga a atenção.
    svg.addEventListener('pointerdown', (down) => {
      if ((down.target as Element).closest('.scene-item')) return;
      clearAttention();
      hush();
    });

    items.forEach((item) => {
      item.el.addEventListener('pointerdown', (down) => {
        if (down.button !== 0) return;
        down.preventDefault();
        // Clicar de novo no mesmo produto desliga a atenção.
        const wasAttended = attended === item;
        clearAttention();
        hush();

        const start = toScene(down);
        const grabX = start.x - item.x;
        const grabY = start.y - (item.run.top - item.h);
        let target: Item | undefined;
        let moved = false;

        // Vai para o fim do desenho para passar por cima dos outros produtos.
        svg.append(item.el);
        item.el.classList.add('dragging');

        const onMove = (move: PointerEvent) => {
          const { x, y } = toScene(move);
          // Um tremor do mouse no clique não conta como arrastar.
          if (!moved && Math.hypot(x - start.x, y - start.y) < 1.5) return;
          moved = true;
          moveTo(
            item,
            Math.round(Math.min(svg.viewBox.baseVal.width - item.w, Math.max(0, x - grabX))),
            Math.round(Math.min(svg.viewBox.baseVal.height - item.h, Math.max(0, y - grabY))),
          );
          const next = itemAt(item, x, y);
          if (next === target) return;
          target?.el.classList.remove('target');
          next?.el.classList.add('target');
          target = next;
        };

        const finish = (drop: boolean) => {
          removeEventListener('pointermove', onMove);
          removeEventListener('pointerup', onUp);
          removeEventListener('pointercancel', onCancel);
          item.el.classList.remove('dragging');
          target?.el.classList.remove('target');
          if (drop && target) swap(item, target);
          else settle(item);
          if (!drop || moved || wasAttended) return;
          say(showAttention(item));
          learned = true;
        };
        const onUp = () => finish(true);
        const onCancel = () => finish(false);

        addEventListener('pointermove', onMove);
        addEventListener('pointerup', onUp);
        addEventListener('pointercancel', onCancel);
      });
    });
  }
</script>
