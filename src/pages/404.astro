---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada | CD2 Open" description="Esse endereço não existe no CD2 Open." noindex>
  <main class="wrap py-20">
    <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl">Esse endereço não existe.</h1>
    <p class="mt-4 max-w-[52ch]">O recurso pode ter mudado de lugar. O catálogo tem tudo que está no ar.</p>
    <a class="btn btn-primary mt-8" href="/">Ir para o catálogo</a>
  </main>
</Base>
