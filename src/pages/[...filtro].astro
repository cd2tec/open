---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import CatalogView from '../components/CatalogView.astro';
import PreviewDialog from '../components/PreviewDialog.astro';
import GameTrigger from '../components/GameTrigger.astro';
import {
  AUDIENCES,
  SHELVES,
  SHELF_ORDER,
  filterHeading,
  filterPath,
  getEntries,
  matches,
  type Audience,
  type ResourceType,
  type ShelfKey,
} from '../lib/catalog';

export async function getStaticPaths() {
  const entries = await getEntries();
  const types = SHELF_ORDER.filter((t) => entries.some((e) => matches(e, undefined, t)));
  const audiences: (Audience | undefined)[] = [undefined, 'negocio', 'tecnico'];
  const tipos: (ShelfKey | undefined)[] = [undefined, ...types];

  return audiences.flatMap((publico) =>
    tipos
      .filter((tipo) => entries.some((e) => matches(e, publico, tipo)))
      .map((tipo) => ({
        params: { filtro: filterPath(publico, tipo).replace(/^\/|\/$/g, '') || undefined },
        props: { entries, publico, tipo },
      })),
  );
}

const { entries, publico, tipo } = Astro.props;
const isHome = !publico && !tipo;
const featured = entries.filter((e) => e.featured);
// Cada coluna dos Destaques gira a sua própria lista, então nunca aparecem três coisas do mesmo tipo.
const slotTypes: ResourceType[][] = [['miniapp'], ['software', 'plugin'], ['skill']];
const highlights = slotTypes.map((types) => featured.filter((e) => types.includes(e.type))).filter((s) => s.length > 0);

const title = isHome
  ? 'CD2 Open: ferramentas gratuitas para quem faz varejo'
  : `${filterHeading(publico, tipo)} | CD2 Open`;
const description = isHome
  ? 'Miniapps, skills, plugins e software gratuitos da CD2 para o varejo. Sem cadastro.'
  : tipo
    ? `${SHELVES[tipo].plural} gratuitos da CD2 ${publico ? AUDIENCES[publico].heading : 'para o varejo'}. Sem cadastro.`
    : `Recursos gratuitos da CD2 ${AUDIENCES[publico!].heading} no varejo. Sem cadastro.`;
---

<Base title={title} description={description} noindex={Boolean(publico && tipo)}>
  <main>
    {
      isHome && (
        <>
          <section class="wrap">
            <div class="on-blue grid gap-10 rounded-3xl bg-retail p-6 text-human md:p-10 lg:grid-cols-[1fr_auto] lg:items-end lg:p-14">
              <div>
                <h1>
                  <span class="block text-[clamp(2.75rem,12vw,8rem)] leading-[0.95] font-extrabold tracking-[-0.04em]">
                    CD2 Open.
                  </span>
                  <span class="mt-5 block max-w-[24ch] text-[clamp(1.375rem,3vw,2.5rem)] leading-tight font-semibold tracking-tight">
                    Ferramentas, skills e software gratuitos para quem faz varejo.
                  </span>
                </h1>
                <div class="mt-8 flex flex-wrap gap-3">
                  <a class="btn btn-human" href={filterPath('negocio')}>Sou do negócio</a>
                  <a class="btn btn-ghost" href={filterPath('tecnico')}>Sou de tecnologia</a>
                </div>
              </div>
              <div class="justify-self-start lg:w-fit lg:justify-self-end">
                <div class="price-tag" role="img" aria-label="Zero reais, sem cadastro">
                  <span class="price-tag-currency" aria-hidden="true">R$</span>
                  <span class="price-tag-value" aria-hidden="true">0</span>
                  <span class="price-tag-cents" aria-hidden="true">,00</span>
                  <span class="price-tag-note" aria-hidden="true">Sem cadastro</span>
                </div>
                <p class="mt-3 max-w-[38ch] text-[0.9375rem] leading-snug font-medium lg:w-0 lg:min-w-full">
                  Tudo aqui dá para experimentar sem pagar. Para usar o Super no dia a dia, com suporte, é só ser cliente
                  CD2.
                </p>
              </div>
            </div>
          </section>

          {highlights.length > 0 && (
            <section class="wrap pt-14">
              <h2 class="text-2xl font-extrabold tracking-tight">Destaques</h2>
              <ul class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                {highlights.map((slot, column) => (
                  <li class="relative" data-highlight-slot>
                    {column === 1 && <GameTrigger />}
                    {slot.map((entry, i) => (
                      <div class="h-full" data-highlight hidden={i > 0}>
                        <Card entry={entry} />
                      </div>
                    ))}
                  </li>
                ))}
              </ul>
              {/* Roda antes de pintar, para o card da entrada anterior não piscar na tela. */}
              <script is:inline>
                (function () {
                  var visit = 0;
                  try {
                    visit = parseInt(localStorage.getItem('cd2-destaques') || '0', 10) || 0;
                    localStorage.setItem('cd2-destaques', String(visit + 1));
                  } catch (e) {
                    visit = Math.floor(Math.random() * 1000);
                  }
                  document.querySelectorAll('[data-highlight-slot]').forEach(function (slot) {
                    var cards = slot.querySelectorAll('[data-highlight]');
                    cards.forEach(function (card, i) {
                      card.hidden = i !== visit % cards.length;
                    });
                  });
                })();
              </script>
            </section>
          )}
        </>
      )
    }

    <CatalogView entries={entries} publico={publico} tipo={tipo} />
  </main>
  <PreviewDialog />
</Base>
